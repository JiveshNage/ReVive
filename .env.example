APP_NAME=ReVive
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api
PROJECT_NAME=ReVive

# Security & JWT Token Config (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-to-a-secure-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database & Cache
DATABASE_URL=sqlite:///./revive.db
REDIS_URL=redis://localhost:6379/0

# Brevo / SMTP Email Configuration
SMTP_SERVER=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_LOGIN=your-smtp-login-email
SMTP_PASSWORD=your-smtp-password-key
SMTP_FROM_EMAIL=noreply@revive.gov.in
SMTP_FROM_NAME="ReVive National E-Waste Portal"

# AI / OpenRouter API Configuration (optional)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# File Upload Security
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads

# Firebase Authentication (Optional for cloud token exchange)
FIREBASE_PROJECT_ID=revive-sih2026
FIREBASE_CREDENTIALS_PATH=

